# Sao chép file này thành ".env" (cùng thư mục) rồi điền thông tin thật.
# KHÔNG gửi file .env cho ai, KHÔNG chiếu lên slide, KHÔNG đưa lên Drive.

# Odoo chạy trên máy bằng Docker
ODOO_URL=http://localhost:8069
# Tên database bạn đặt khi tạo ở http://localhost:8069
ODOO_DB=tiemnail
# Email đăng nhập Odoo
ODOO_USER=email@example.com
# API key tạo trong Odoo: ảnh đại diện > Preferences/Tùy chọn > Account Security > New API Key
ODOO_API_KEY=

# API key OpenRouter
OPENROUTER_API_KEY=
# Model rẻ, đủ dùng cho demo; có thể đổi sau
OPENROUTER_MODEL=openai/gpt-4.1-mini
